[{"Id":"live_tip-audience_shortage-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":7,"Description":"観客数が少ないようです。お仕事でアイドルの\nファン数、コアファン率を上昇させましょう。","Priority":7},{"Id":"live_tip-audience_shortage-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":7,"Description":"観客数が少ないようです。観客数が多いほどスコアに\nボーナスがつき、またスキルをミスする確率が低下します。","Priority":7},{"Id":"live_tip-deck_unbalance-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":9,"Description":"スコアラータイプが多すぎるようです。SPスキル位置以外\nにはサポーター、バッファーをバランス良く配置しましょう。","Priority":9},{"Id":"live_tip-deck_unbalance-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":9,"Description":"スコアラータイプが多すぎるようです。外側にはサポーター\nタイプ、その他の位置にはバッファータイプがおすすめです。","Priority":9},{"Id":"live_tip-in_cool_time-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":3,"Description":"Aスキル発動が多い位置でうまく発動できていないようです。\nAスキルのCT(クールタイム)が短いアイドルを配置しましょう。","Priority":4},{"Id":"live_tip-in_cool_time-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":3,"Description":"Aスキル発動が多い位置でうまく発動できていないようです。\nAスキルを2つ持ったアイドルがいれば配置してみましょう。","Priority":4},{"Id":"live_tip-in_cool_time-03","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":3,"Description":"Aスキル未発動だとコンボが途切れてスコアが伸びません。\nレーン情報とAスキルのCTを確認して適切に配置しましょう。","Priority":4},{"Id":"live_tip-level_shortage-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":8,"Description":"ライブ難易度に対してアイドルのレベルが足りないようです。\n「アイドル強化」でアイドルのレベルアップをしましょう。","Priority":8},{"Id":"live_tip-low_activating_rate-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":2,"Description":"スキルチャンスを相手に多く取られているようです。レーン\nごとにパラメータが高いアイドルがスキル発動権利を得ます。","Priority":3},{"Id":"live_tip-low_activating_rate-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":2,"Description":"スキルチャンスを相手に多く取られているようです。\nチャンスを奪うためにスタミナ回復が有効なことがあります。","Priority":3},{"Id":"live_tip-miss-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":5,"Description":"スキルをミスしてしまっているようです。\nサブアクセサリやフォトでメンタルを補いましょう。","Priority":2},{"Id":"live_tip-miss-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":5,"Description":"スキルをミスしてしまっているようです。\n観客数、メンタルを増やしてスキルのミスを減らしましょう。","Priority":2},{"Id":"live_tip-not_possessed-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":1,"Description":"SPスキルが発動できていません。\nレーン情報の「SP」位置にはスコアラーを配置しましょう。","Priority":1},{"Id":"live_tip-not_possessed-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":1,"Description":"SPスキルが発動できていません。レーン情報の「SP」の\n位置にはSPスキルを所持したアイドルを配置しましょう。","Priority":1},{"Id":"live_tip-other-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":10,"Description":"レーンの色はボーカル、ダンス、ビジュアルを示しています。\nアクセサリ、フォトも対応する色に合わせて編成しましょう。","Priority":10},{"Id":"live_tip-other-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":10,"Description":"ライブ難易度に対してアイドルのレベルが足りないようです。\nレッスンピースが足りない時はマーケットで購入しましょう。","Priority":10},{"Id":"live_tip-skill_heavy_weight-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":6,"Description":"Aスキルで獲得するスコアにボーナスがつくライブです。\n「Aスキルスコアアップ」でAスキルの効果を高めましょう。","Priority":6},{"Id":"live_tip-skill_heavy_weight-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":6,"Description":"Aスキルで獲得するスコアにボーナスがつくライブです。\nAスキルの直前に強化効果が発動するよう配置しましょう。","Priority":6},{"Id":"live_tip-stamina_shortage-01","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":4,"Description":"スタミナ不足でスキルが発動できていないようです。\nサブアクセサリやフォトでスタミナを補いましょう。","Priority":5},{"Id":"live_tip-stamina_shortage-02","__unknown":[],"__msg":"Solis.Common.Proto.Master.LiveTip","Type":4,"Description":"スタミナ不足でスキルが発動できていないようです。\nスタミナ回復スキルを所持したアイドルを編成しましょう。","Priority":5}]
